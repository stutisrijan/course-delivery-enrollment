generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  INSTRUCTOR
  LEARNER
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  courses          Course[]          @relation("InstructorCourses")
  enrollments      Enrollment[]      @relation("LearnerEnrollments")
  lessonProgress   LessonProgress[]
  activityLogs     ActivityLog[]     @relation("ActivityActors")
  inactivityAlerts InactivityAlert[] @relation("AlertLearners")
}

model Course {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  description  String
  category     String
  status       CourseStatus @default(DRAFT)
  instructorId String       @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  instructor       User              @relation("InstructorCourses", fields: [instructorId], references: [id])
  lessons          Lesson[]
  enrollments      Enrollment[]
  activityLogs     ActivityLog[]
  inactivityAlerts InactivityAlert[]

  @@index([status])
  @@index([category])
  @@index([instructorId])
  @@index([createdAt])
}

model Lesson {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @db.Uuid
  title     String
  content   String
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId])
  @@index([courseId, position])
}

model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  learnerId  String   @db.Uuid
  courseId   String   @db.Uuid
  enrolledAt DateTime @default(now())

  learner User   @relation("LearnerEnrollments", fields: [learnerId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([learnerId, courseId])
  @@index([learnerId])
  @@index([courseId])
}

model LessonProgress {
  id          String    @id @default(uuid()) @db.Uuid
  learnerId   String    @db.Uuid
  lessonId    String    @db.Uuid
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  learner User   @relation(fields: [learnerId], references: [id])
  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([learnerId, lessonId])
  @@index([learnerId])
  @@index([lessonId])
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  courseId   String   @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String   @db.Uuid
  comment    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id])
  actor  User   @relation("ActivityActors", fields: [actorId], references: [id])

  @@index([courseId])
  @@index([actorId])
  @@index([createdAt])
  @@index([courseId, createdAt])
}

model InactivityAlert {
  id             String    @id @default(uuid()) @db.Uuid
  learnerId      String    @db.Uuid
  courseId       String    @db.Uuid
  lastProgressAt DateTime
  dismissedAt    DateTime?
  createdAt      DateTime  @default(now())

  learner User   @relation("AlertLearners", fields: [learnerId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@index([learnerId])
  @@index([courseId])
  @@index([createdAt])
  @@index([learnerId, courseId])
}
